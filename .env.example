# Liba OS (call-control). Local default: http://localhost:3000
LIBA_OS_BASE_URL=http://localhost:3000
LIBA_OS_API_KEY=

# Voicenter (never commit real values)
VOICENTER_API_CODE=
VOICENTER_EXTENSION=LvMpqlBj
VOICENTER_USER_ID=211361
VOICENTER_AGENT_NAME=סופיה
VOICENTER_REQUIRE_ANSWER=1
VOICENTER_REQUIRE_RECORDING=1
# 1 = also require שיקוף/רגולציה keywords in CDR fields (off until we see tags)
VOICENTER_TOPIC_FILTER=0
# Optional shared secret for PUSH webhook (?token=... or X-Voicenter-Token)
VOICENTER_WEBHOOK_TOKEN=
# Enable Sofia worker loop in deploy/start.sh
CALL_QA_VOICENTER_ENABLED=0
